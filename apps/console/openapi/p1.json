{
 "openapi": "3.1.0",
 "info": {
  "title": "Operations Performance API",
  "description": "Analytics API over the Northstar Manufacturing procurement process. Read-only except the admin-only intervention ledger (POST /interventions). Wraps the same analytics/ML logic used by the local pipeline and dashboard, so there's one source of truth for every number -- including for operations-assistant, which consumes these endpoints as agent tools rather than reimplementing the logic.",
  "version": "0.1.0"
 },
 "paths": {
  "/v1/mlops/registry": {
   "get": {
    "tags": [
     "v1"
    ],
    "summary": "V1 Mlops Registry",
    "description": "Champion/challenger state, version list and the latest promotion/rollback events (src/mlops). Read-only; creates nothing.",
    "operationId": "v1_mlops_registry_v1_mlops_registry_get",
    "parameters": [
     {
      "name": "name",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "pattern": "^[A-Za-z0-9_-]{1,64}$",
       "default": "sla_risk",
       "title": "Name"
      }
     },
     {
      "name": "events",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "maximum": 100,
       "minimum": 0,
       "default": 15,
       "title": "Events"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/RegistryStatus"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
