# Used by scripts/run_pipeline.py and scripts/setup_database.py -- should be the
# ops_pipeline_writer role once sql/schema/004_create_roles.sql has been applied
# (see docs/security-notes.md). Falls back to a single admin user for initial local setup.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=operations_performance
DB_USER=operations_admin
DB_PASSWORD=changeme
# "prefer" (default) for a plain local Postgres; "require" for a hosted instance like
# Neon, which rejects unencrypted connections.
DB_SSLMODE=prefer

RAW_EVENT_LOG_PATH=data/raw/bpi2019_events.csv

# API (src/api/) -- optional dedicated read-only credential. If set, the API uses
# these instead of DB_USER/DB_PASSWORD above (see src/api/db.py:get_engine). Should
# be the ops_api_reader role from sql/schema/004_create_roles.sql in a real setup.
# Falls back to DB_USER/DB_PASSWORD if unset, for simple local dev.
API_DB_USER=ops_api_reader
API_DB_PASSWORD=changeme
API_ALLOWED_ORIGINS=http://localhost:3000

# API authentication (src/api/auth.py) -- every endpoint except GET /health requires
# a valid key in an X-API-Key request header. If neither this nor API_KEYS below is
# set, auth fails OPEN for local development -- a real deployment MUST set one of them.
#
# Option A: a single shared secret (simplest, no per-client tracking/revocation).
API_KEY=changeme-generate-a-real-secret
#
# Option B (recommended for anything beyond a single caller): per-client keys with
# named roles, comma-separated `name:key:role` triples. Revoke one client by
# removing its entry, without rotating everyone else's key. Both can be set at
# once -- API_KEY keeps working as a synthetic "default" admin client.
# API_KEYS=analyst:changeme-1:reader,ci-pipeline:changeme-2:reader,admin:changeme-3:admin

# BigQuery migration (Phase 8) -- only needed if running scripts/migrate_to_bigquery.py
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
GCP_PROJECT_ID=your-gcp-project-id
BQ_DATASET_STAGING=operations_performance_staging
BQ_DATASET_ANALYTICS=operations_performance_analytics
