# Names only: never commit values. Each service also keeps its own .env.example under services/*.
# --- Neon (new project; the old one hit its free-tier limit) ---
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSLMODE=require
# --- Free model keys (Google AI Studio, Groq): set in the assistant's environment only ---
GEMINI_API_KEY=
GROQ_API_KEY=
# --- Service-to-service secrets (generate your own; Secret Manager in the cloud) ---
API_KEY=
OPS_PERFORMANCE_API_KEY=
# --- GCP (only after the free trial is started) ---
GCP_PROJECT_ID=
GCP_REGION=
