# Pinned versions of every tool the checks use. One place, sourced by scripts/install-tools.sh
# (locally and in CI), so a result never depends on "whatever was latest this morning".
# Bump deliberately, then run scripts/check.sh: a new Terraform, provider or policy engine can
# change plan JSON, and the mutation tests exist to notice that.

TERRAFORM_VERSION=1.16.4
TFLINT_VERSION=0.64.0            # ruleset plugin versions are pinned in .tflint.hcl
CONFTEST_VERSION=0.70.1          # bundles OPA 1.x (Rego v1 syntax)
TRIVY_VERSION=0.74.0
TERRAFORM_DOCS_VERSION=0.24.0
CHECKOV_VERSION=3.3.19           # installed with pip
ACTIONLINT_VERSION=1.7.12        # lints the workflows; uses shellcheck on the run: blocks when it is on PATH
