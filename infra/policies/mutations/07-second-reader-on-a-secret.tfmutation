# root: dev
# expect: SEC-001
# what: the gateway "also needs" the LLM key, so it is added as a second reader of the secret
#       instead of creating a second secret.
resource "google_secret_manager_secret_iam_member" "mutation" {
  project   = var.project_id
  secret_id = "groq-api-key"
  role      = "roles/secretmanager.secretAccessor"
  member    = "serviceAccount:gateway-sa@${var.project_id}.iam.gserviceaccount.com"
}
