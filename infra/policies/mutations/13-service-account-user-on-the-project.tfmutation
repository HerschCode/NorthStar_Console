# root: dev
# expect: IAM-002
# what: a deployer is given serviceAccountUser on the whole project instead of on one service
#       account, so it can attach ANY service account (including the powerful ones) to a revision.
resource "google_project_iam_member" "mutation" {
  project = var.project_id
  role    = "roles/iam.serviceAccountUser"
  member  = "serviceAccount:gh-deploy-gateway@${var.project_id}.iam.gserviceaccount.com"
}
