# root: bootstrap
# expect: WIF-002
# what: the apply identity is made impersonable by EVERY identity in the pool, not one workflow.
resource "google_service_account_iam_member" "mutation" {
  service_account_id = "projects/${var.project_id}/serviceAccounts/gh-tf-apply@${var.project_id}.iam.gserviceaccount.com"
  role               = "roles/iam.workloadIdentityUser"
  member             = "principalSet://iam.googleapis.com/projects/${var.project_number}/locations/global/workloadIdentityPools/github/*"
}
