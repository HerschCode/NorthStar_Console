# root: dev
# expect: SEC-002
# what: "secretAccessor at project level is easier than one binding per secret".
resource "google_project_iam_member" "mutation" {
  project = var.project_id
  role    = "roles/secretmanager.secretAccessor"
  member  = "serviceAccount:assistant-sa@${var.project_id}.iam.gserviceaccount.com"
}
